{
  "_meta": {
    "version": 1,
    "description": "Agent 编排评测集 v1（路线图 Phase B/B6）。CI 模式：脚本 LLM 回放 expected_tool_calls 验证编排管线（治理面/执行/落库/人审路由）；在线模式：设置 ERP_EVAL_LLM_ENABLED=true 后由真模型执行并断言行为一致（tests/test_agent_evals.py::test_online_eval）。新增场景请保持相同结构。",
    "fields": {
      "id": "用例唯一标识",
      "domain": "Agent 域（决定场景图）",
      "message": "用户指令",
      "expected_tool_calls": "期望的工具调用序列 [{name, args}]",
      "expect_status": "done | awaiting_approval",
      "expect_db": "可选 {table, where, count} 执行后 DB 断言"
    }
  },
  "cases": [
    {
      "id": "reimb_query_list",
      "domain": "reimbursement",
      "message": "查一下最近的报销单",
      "expected_tool_calls": [
        {
          "name": "reimbursement_query_list",
          "args": {
            "limit": 20
          }
        }
      ],
      "expect_status": "done"
    },
    {
      "id": "reimb_query_stats",
      "domain": "reimbursement",
      "message": "报销整体情况怎么样",
      "expected_tool_calls": [
        {
          "name": "reimbursement_query_stats",
          "args": {}
        }
      ],
      "expect_status": "done"
    },
    {
      "id": "reimb_submit_low",
      "domain": "reimbursement",
      "message": "帮李四提交一笔300元的餐费报销",
      "expected_tool_calls": [
        {
          "name": "reimbursement_submit",
          "args": {
            "employee_name": "李四",
            "category": "meal",
            "amount": 300,
            "description": "餐费报销",
            "has_receipt": true
          }
        }
      ],
      "expect_status": "done",
      "expect_db": {
        "table": "reimbursements",
        "where": "employee_name = '李四'",
        "count": 1
      }
    },
