# ============================================================
# Agent-Native ERP System - 根目录环境变量模板
# 复制此文件为 .env 并修改配置: cp .env.example .env
#
# 说明:
#   - 所有后端配置项使用 ERP_ 前缀 (匹配 pydantic-settings 配置)
#   - 后端服务通过 backend/.env 加载, 内容与本文件 ERP_ 部分一致
#   - 基础设施变量 (MYSQL_*, GF_*) 由 docker-compose 直接使用
# ============================================================

# ============================================================
# 一、应用配置
# ============================================================
ERP_APP_NAME=Agent-Native ERP
ERP_APP_VERSION=1.0.0
ERP_DEBUG=true
ERP_ENVIRONMENT=development

# 当前域 (agent_execution / data_knowledge / user_interaction)
ERP_CURRENT_DOMAIN=agent_execution

# ============================================================
# 二、持久化后端配置 (MySQL)
# ============================================================
# 持久化后端类型: memory (开发/测试) | mysql (生产)
ERP_DB_BACKEND=memory

# 数据库连接URL (格式: mysql+aiomysql://用户:密码@主机:端口/数据库名?charset=utf8mb4)
# 主机名 mysql 为 docker-compose 中的服务名
ERP_MYSQL_URL=mysql+aiomysql://erp:erp_password@mysql:3306/erp_db?charset=utf8mb4

# 数据库连接池配置
ERP_DB_POOL_SIZE=10
ERP_DB_MAX_OVERFLOW=20
ERP_DB_POOL_TIMEOUT=30
ERP_DB_POOL_RECYCLE=1800
ERP_DB_ECHO=false

# ============================================================
# 三、缓存后端配置 (Redis)
# ============================================================
# 缓存后端类型: memory (开发/测试) | redis (生产)
ERP_CACHE_BACKEND=memory

# Redis 连接URL (主机名 redis 为 docker-compose 中的服务名)
ERP_REDIS_URL=redis://redis:6379/0

# Redis 连接池配置
ERP_REDIS_MAX_CONNECTIONS=20
ERP_REDIS_DEFAULT_TTL=300

# ============================================================
# 四、Kafka 事件总线配置 (可选, 当前使用内存事件总线)
# ============================================================
ERP_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ERP_KAFKA_EVENT_TOPIC=erp.events
ERP_KAFKA_AUDIT_TOPIC=erp.audit
ERP_KAFKA_CONSUMER_GROUP=erp-agent-group

# ============================================================
# 五、LLM 大语言模型配置 (DeepSeek V4 Pro)
# DeepSeek API 完全兼容 OpenAI 格式，直接替换即可
# 文档: https://api-docs.deepseek.com/zh-cn/
# ============================================================
ERP_LLM_BASE_URL=https://api.deepseek.com
ERP_LLM_MODEL=deepseek-v4-pro
ERP_LLM_API_KEY=sk-your-deepseek-api-key
ERP_LLM_TEMPERATURE=0.3
ERP_LLM_MAX_TOKENS=8192
# LLM 认知引擎开关 (false=关闭, 降级到规则引擎; true=启用LLM决策)
ERP_LLM_ENABLED=false
# LLM 不可用时是否降级到规则引擎
ERP_LLM_FALLBACK_TO_RULES=true
# LLM 请求超时时间 (秒) — DeepSeek思考模式需要更长时间
ERP_LLM_TIMEOUT=60
# LLM 请求最大重试次数 (指数退避)
ERP_LLM_MAX_RETRIES=3
# LLM 速率限制 (每秒最大请求数, 令牌桶算法)
ERP_LLM_RATE_LIMIT=10
# DeepSeek思考模式 (true=开启深度思考, false=关闭以获得更快响应)
ERP_LLM_THINKING_ENABLED=true

# ============================================================
# 六、JWT 认证与安全配置
# ============================================================
ERP_JWT_SECRET=change-this-in-production-use-hsm
ERP_JWT_ALGORITHM=HS256
ERP_JWT_EXPIRE_MINUTES=30
ERP_MTLS_ENABLED=false

# ============================================================
# 七、审计链配置
# ============================================================
ERP_AUDIT_CHAIN_ENABLED=true
ERP_AUDIT_HASH_ALGORITHM=sha256

# ============================================================
# 八、Agent 配置
# ============================================================
ERP_AGENT_HEALTH_CHECK_INTERVAL=30
ERP_AGENT_SLO_RESPONSE_TIME_MS=5000
ERP_AGENT_CIRCUIT_BREAKER_THRESHOLD=5
ERP_AGENT_CONSENSUS_THRESHOLD=0.67

# ============================================================
# 九、人在回路配置
# ============================================================
ERP_HUMAN_APPROVAL_TIMEOUT=3600
ERP_AUTO_FALLBACK_TO_HUMAN=true

# ============================================================
# 十、监控配置
# ============================================================
ERP_PROMETHEUS_PORT=9090
ERP_METRICS_ENABLED=true

# ============================================================
# 十一、基础设施变量 (docker-compose 使用)
# ============================================================

# MySQL 初始化 (由 init-db.sql 创建应用数据库和用户)
MYSQL_ROOT_PASSWORD=root_admin
MYSQL_DATABASE=erp_db
MYSQL_USER=erp
MYSQL_PASSWORD=erp_password

# Grafana 管理员凭据
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

# ============================================================
# 十二、前端配置 (Vite 环境变量)
# ============================================================
# 前端 API 基础路径 (开发环境通过 vite proxy 代理到后端)
VITE_API_BASE_URL=/api/v1

# ============================================================
# 十三、时区配置 (Docker 容器时区)
# ============================================================
TZ=Asia/Shanghai
