{
  "customizations": [
    {
      "type": "tool",
      "target": "reimbursement_submit",
      "enabled": true,
      "overrides": {}
    },
    {
      "type": "tool",
      "target": "reimbursement_query_detail",
      "enabled": false,
      "overrides": {
        "reason": "临时下线"
      }
    },
    {
      "type": "agent",
      "target": "reimbursement",
      "enabled": true,
      "overrides": {
        "prompt_override": "你是报销领域的严谨审核助手，只依据单据事实作答，金额存疑必须转人审。",
        "temperature": 0.2,
        "daily_token_budget": 60000,
        "tool_whitelist": [
          "reimbursement_submit"
        ],
        "params": {
          "require_receipt": true
        }
      }
    },
    {
      "type": "gate",
      "target": "approval_route_matrix",
      "enabled": true,
      "overrides": {
        "rules": [
          {
            "document_type": "treasury_fund_transfer_request",
            "amount_min": 100000,
            "approve_roles": [
              "cfo",
              "chairman"
            ],
            "mode": "all"
          },
          {
            "document_type": "reimbursement_submit",
            "amount_min": 0,
            "amount_max": 5000,
            "approve_roles": [
              "fin_manager"
            ],
            "mode": "any"
          }
        ],
        "default": "legacy"
      }
    }
  ]
}