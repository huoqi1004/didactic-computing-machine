# ERP 生产 TLS 终结（P1-8 整改交付物）
# =====================================
# Caddy 自动 ACME 证书（HTTP-01/TLS-ALPN-01），443 公网唯一入口；
# erp-backend:8000 / erp-frontend 仅保留内网端口（compose 中已移除对外映射）。
# 环境变量：ERP_DOMAIN=erp.example.com  ACME_EMAIL=ops@example.com
{
	email {$ACME_EMAIL}
}

{$ERP_DOMAIN} {
	encode gzip zstd

	# 安全响应头
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# WebSocket（/api/v1/ws/*）—— Caddy 反代自动支持升级
	@api path /api/*
	handle @api {
		reverse_proxy erp-backend:8000
	}

	# 前端静态（erp-frontend 为 nginx 静态容器）
	handle {
		reverse_proxy erp-frontend:80
	}
}
